<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!-- Woken by Play services when the SimpMusic watch app sends a message under /simpmusic,
             even when the phone app is not running. -->
        <service
            android:name="org.simpmusic.wear.WearBridgeService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data
                    android:host="*"
                    android:pathPrefix="/simpmusic"
                    android:scheme="wear" />
            </intent-filter>
        </service>
    </application>

</manifest>
